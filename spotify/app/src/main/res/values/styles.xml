<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LirnykRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lk_bg</item>
        <item name="android:colorBackground">@color/lk_bg</item>
        <item name="android:colorAccent">@color/lk_accent</item>
        <item name="android:colorPrimary">@color/lk_bg</item>
        <item name="android:colorPrimaryDark">@color/lk_bg</item>
        <item name="android:statusBarColor">@color/lk_bg</item>
        <item name="android:navigationBarColor">@color/lk_bg</item>
        <item name="android:textColorPrimary">@color/lk_text</item>
        <item name="android:textColorSecondary">@color/lk_text2</item>
    </style>
    <style name="R" />
    <style name="R.Title"><item name="android:textColor">@color/lk_text</item><item name="android:textSize">30sp</item><item name="android:textStyle">bold</item><item name="android:maxLines">2</item><item name="android:ellipsize">end</item></style>
    <style name="R.Sub"><item name="android:textColor">@color/lk_text2</item><item name="android:textSize">20sp</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item></style>
    <style name="R.Small"><item name="android:textColor">@color/lk_text2</item><item name="android:textSize">16sp</item></style>
    <style name="R.Button">
        <item name="android:background">@drawable/lk_button</item>
        <item name="android:textColor">@color/lk_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
