<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/lk_surface_pressed" /><corners android:radius="@dimen/lk_radius" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/lk_surface_pressed" /><corners android:radius="@dimen/lk_radius" /><stroke android:width="2dp" android:color="@color/lk_accent" /></shape></item>
    <item><shape><solid android:color="@color/lk_surface" /><corners android:radius="@dimen/lk_radius" /></shape></item>
</selector>
