<?xml version="1.0" encoding="utf-8"?>
<!-- Shared header: back is always top left (concept: "Назад" always in one place). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/lk_back"
        android:layout_width="@dimen/lk_touch"
        android:layout_height="@dimen/lk_touch"
        android:background="@drawable/lk_round"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_lk_back" />

    <TextView
        android:id="@+id/lk_header_title"
        style="@style/Lirnyk.Header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lk_pad"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/lk_header_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
