<?xml version="1.0" encoding="utf-8"?>
<!-- «Ближнє світло» player: one big button, one accent colour, at most six controls besides the four tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/lk_pad_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            style="@style/Lirnyk.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/favorite"
            android:layout_width="@dimen/lk_small_button"
            android:layout_height="@dimen/lk_small_button"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_lk_star_border" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/title"
        style="@style/Lirnyk.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/artist"
        style="@style/Lirnyk.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/note"
        style="@style/Lirnyk.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/lk_accent"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/lk_pad"
        android:max="1000"
        android:maxHeight="@dimen/lk_progress_height"
        android:minHeight="@dimen/lk_progress_height"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressDrawable="@drawable/lk_progress"
        android:splitTrack="false"
        android:thumbTint="@color/lk_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/elapsed"
            style="@style/Lirnyk.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/duration"
            style="@style/Lirnyk.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lk_pad"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/shuffle"
            android:layout_width="@dimen/lk_small_button"
            android:layout_height="@dimen/lk_small_button"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_lk_shuffle" />

        <ImageButton
            android:id="@+id/prev"
            android:layout_width="@dimen/lk_side_button"
            android:layout_height="@dimen/lk_side_button"
            android:layout_marginStart="@dimen/lk_pad_large"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/previous"
            android:scaleType="center"
            android:src="@drawable/ic_lk_prev" />

        <ImageButton
            android:id="@+id/play"
            android:layout_width="@dimen/lk_main_button"
            android:layout_height="@dimen/lk_main_button"
            android:layout_marginStart="@dimen/lk_pad_large"
            android:layout_marginEnd="@dimen/lk_pad_large"
            android:background="@drawable/lk_button_accent"
            android:contentDescription="@string/play"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lk_play_accent" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="@dimen/lk_side_button"
            android:layout_height="@dimen/lk_side_button"
            android:layout_marginEnd="@dimen/lk_pad_large"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/next"
            android:scaleType="center"
            android:src="@drawable/ic_lk_next" />

        <ImageButton
            android:id="@+id/repeat"
            android:layout_width="@dimen/lk_small_button"
            android:layout_height="@dimen/lk_small_button"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_lk_repeat" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/lk_tile_height"
        android:orientation="horizontal">

        <TextView android:id="@+id/tile_library" style="@style/Lirnyk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:drawableStart="@drawable/ic_lk_library" android:drawablePadding="8dp" android:maxLines="1" android:ellipsize="end" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/tile_library" />
        <TextView android:id="@+id/tile_sources" style="@style/Lirnyk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:drawableStart="@drawable/ic_lk_folder" android:drawablePadding="8dp" android:maxLines="1" android:ellipsize="end" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/tile_sources" />
        <TextView android:id="@+id/tile_check" style="@style/Lirnyk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:drawableStart="@drawable/ic_lk_check" android:drawablePadding="8dp" android:maxLines="1" android:ellipsize="end" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/tile_check" />
        <TextView android:id="@+id/tile_settings" style="@style/Lirnyk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_lk_settings" android:drawablePadding="8dp" android:maxLines="1" android:ellipsize="end" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/tile_settings" />
    </LinearLayout>
</LinearLayout>
