<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/lk_pad">

    <include layout="@layout/lk_header" />

    <HorizontalScrollView
        android:id="@+id/tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="@dimen/lk_touch"
            android:layout_weight="1"
            android:background="@drawable/lk_button"
            android:hint="@string/lib_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingStart="@dimen/lk_pad"
            android:paddingEnd="@dimen/lk_pad"
            android:textColor="@color/lk_text"
            android:textColorHint="@color/lk_text2"
            android:textSize="@dimen/lk_text_body" />

        <ImageButton
            android:id="@+id/search_close"
            android:layout_width="@dimen/lk_touch"
            android:layout_height="@dimen/lk_touch"
            android:layout_marginStart="8dp"
            android:background="@drawable/lk_round"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_lk_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/play_all"
        style="@style/Lirnyk.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_lk_play"
        android:drawablePadding="8dp"
        android:text="@string/lib_play_all"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/lk_index_width"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/index"
            android:layout_width="@dimen/lk_index_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/empty"
            style="@style/Lirnyk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/lk_pad_large"
            android:textColor="@color/lk_text2"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
